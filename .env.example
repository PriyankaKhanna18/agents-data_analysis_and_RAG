# Copy this file to .env and fill in your own values:
#   cp .env.example .env
# .env is git-ignored, so your keys are never committed.

# --- Required ----------------------------------------------------------------
# Cohere powers both agents (chat model command-a-03-2025 and embed-english-v3.0).
# Get a key at https://dashboard.cohere.com/api-keys (trial keys work).
COHERE_API_KEY=

# --- Optional ----------------------------------------------------------------
# LangSmith tracing (https://smith.langchain.com). `langgraph dev` / Studio also
# uses this key; leave tracing off if you don't have one.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
# LANGSMITH_PROJECT=applied-gen-ai

# Where `langgraph dev` serves chart images (chart_server.py). Change only if
# you run the dev server on a different host/port.
# CHART_BASE_URL=http://127.0.0.1:2024

# Only used by the experimental scratch scripts, not by the two main agents.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
